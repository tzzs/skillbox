{
  "name": "@skillbox/web",
  "version": "0.1.0",
  "description": "Skillbox web frontend (React + Vite)",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
