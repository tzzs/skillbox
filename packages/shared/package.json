{
  "name": "@skillbox/shared",
  "version": "0.1.0",
  "description": "Workspace-private: the Web JSON API contract, declared once so the server and the SPA cannot each write their own copy. Types only — never published.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@skillbox/core": "workspace:^",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tzzs/skillbox.git",
    "directory": "packages/shared"
  }
}
