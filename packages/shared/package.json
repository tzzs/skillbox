{
  "name": "@skillbox/shared",
  "version": "0.1.0",
  "description": "Skillbox shared utilities",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  }
}
