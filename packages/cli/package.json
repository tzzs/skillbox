{
  "name": "@skillbox/cli",
  "version": "0.1.0",
  "description": "Skillbox CLI entry point",
  "private": false,
  "type": "module",
  "bin": {
    "skillbox": "./bin/skillbox.mjs"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/test-support.js",
    "!dist/**/test-support.js.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src bin --max-warnings 0",
    "format": "prettier --write src bin",
    "prepublishOnly": "pnpm --workspace-root build && pnpm --workspace-root pack:verify"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^1.13.7",
    "@skillbox/core": "^0.1.0",
    "commander": "^13.1.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@skillbox/shared": "workspace:^",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tzzs/skillbox.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tzzs/skillbox#readme",
  "bugs": {
    "url": "https://github.com/tzzs/skillbox/issues"
  }
}
