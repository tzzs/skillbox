{
  "name": "@skillbox/cli",
  "version": "0.1.0",
  "description": "Skillbox CLI entry point",
  "private": true,
  "type": "module",
  "bin": {
    "skillbox": "./bin/skillbox.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src bin --max-warnings 0",
    "format": "prettier --write src bin"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^1.13.7",
    "@skillbox/core": "workspace:*",
    "@skillbox/shared": "workspace:*",
    "commander": "^13.1.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.2",
    "vitest": "^3.0.0"
  }
}
