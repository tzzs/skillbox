{
  "name": "skillbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @skillbox/web build && node scripts/package-web.mjs",
    "typecheck": "tsc -b && pnpm --filter @skillbox/web typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "skillbox": "skillbox"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@skillbox/cli": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  }
}
